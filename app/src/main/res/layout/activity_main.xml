<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111827"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INTERVAL RUNNER"
            android:textColor="#55FFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- ======= SETUP LAYOUT ======= -->
        <LinearLayout
            android:id="@+id/layoutSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="session setup"
                    android:textColor="#66FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <!-- Walk + Run row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Walk -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="walk (min)" android:textColor="#66FFFFFF" android:textSize="11sp"
                            android:layout_marginBottom="8dp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <Button android:id="@+id/btnWalkMinus"
                                style="@style/Widget.AppCompat.Button.Borderless"
                                android:layout_width="36dp" android:layout_height="36dp"
                                android:text="−" android:textColor="#CCFFFFFF" android:textSize="20sp"
                                android:background="@drawable/bg_btn_control" android:padding="0dp" />
                            <TextView android:id="@+id/tvWalkValue"
                                android:layout_width="40dp" android:layout_height="wrap_content"
                                android:text="4" android:textColor="#FFFFFF" android:textSize="22sp"
                                android:gravity="center" android:fontFamily="sans-serif-medium" />
                            <Button android:id="@+id/btnWalkPlus"
                                style="@style/Widget.AppCompat.Button.Borderless"
                                android:layout_width="36dp" android:layout_height="36dp"
                                android:text="+" android:textColor="#CCFFFFFF" android:textSize="20sp"
                                android:background="@drawable/bg_btn_control" android:padding="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Run -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="run (min)" android:textColor="#66FFFFFF" android:textSize="11sp"
                            android:layout_marginBottom="8dp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <Button android:id="@+id/btnRunMinus"
                                style="@style/Widget.AppCompat.Button.Borderless"
                                android:layout_width="36dp" android:layout_height="36dp"
                                android:text="−" android:textColor="#CCFFFFFF" android:textSize="20sp"
                                android:background="@drawable/bg_btn_control" android:padding="0dp" />
                            <TextView android:id="@+id/tvRunValue"
                                android:layout_width="40dp" android:layout_height="wrap_content"
                                android:text="1" android:textColor="#FFFFFF" android:textSize="22sp"
                                android:gravity="center" android:fontFamily="sans-serif-medium" />
                            <Button android:id="@+id/btnRunPlus"
                                style="@style/Widget.AppCompat.Button.Borderless"
                                android:layout_width="36dp" android:layout_height="36dp"
                                android:text="+" android:textColor="#CCFFFFFF" android:textSize="20sp"
                                android:background="@drawable/bg_btn_control" android:padding="0dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Reps row -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="repetitions" android:textColor="#66FFFFFF" android:textSize="11sp"
                        android:layout_marginBottom="8dp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <Button android:id="@+id/btnRepsMinus"
                            style="@style/Widget.AppCompat.Button.Borderless"
                            android:layout_width="36dp" android:layout_height="36dp"
                            android:text="−" android:textColor="#CCFFFFFF" android:textSize="20sp"
                            android:background="@drawable/bg_btn_control" android:padding="0dp" />
                        <TextView android:id="@+id/tvRepsValue"
                            android:layout_width="40dp" android:layout_height="wrap_content"
                            android:text="3" android:textColor="#FFFFFF" android:textSize="22sp"
                            android:gravity="center" android:fontFamily="sans-serif-medium" />
                        <Button android:id="@+id/btnRepsPlus"
                            style="@style/Widget.AppCompat.Button.Borderless"
                            android:layout_width="36dp" android:layout_height="36dp"
                            android:text="+" android:textColor="#CCFFFFFF" android:textSize="20sp"
                            android:background="@drawable/bg_btn_control" android:padding="0dp" />
                        <TextView android:id="@+id/tvTotalDuration"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="= 15 min total" android:textColor="#44FFFFFF"
                            android:textSize="12sp" android:layout_marginStart="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Distance estimate hint -->
            <TextView
                android:id="@+id/tvDistanceHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="~2.1 km estimated"
                android:textColor="#88FFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Start button -->
            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Start"
                android:textColor="#0A2A18"
                android:background="@drawable/bg_btn_green"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- ======= TIMER LAYOUT ======= -->
        <LinearLayout
            android:id="@+id/layoutTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Timer card -->
            <LinearLayout
                android:id="@+id/timerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_walk"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvPhaseLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WALK"
                    android:textColor="#B8F5D4"
                    android:textSize="14sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4:00"
                    android:textColor="#63DC96"
                    android:textSize="72sp"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvRepCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="rep 1 of 3"
                    android:textColor="#66FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Pause + Stop buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="0dp">

                <Button
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Pause"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_outline_white"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Stop"
                    android:textColor="#FF6B6B"
                    android:background="@drawable/bg_btn_outline_red"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ======= FINISHED LAYOUT ======= -->
        <LinearLayout
            android:id="@+id/layoutFinished"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workout complete!"
                android:textColor="#63DC96"
                android:textSize="28sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvFinishSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="40dp" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Back to setup"
                android:textColor="#0A2A18"
                android:background="@drawable/bg_btn_green"
                android:textSize="15sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
